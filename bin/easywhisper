#!/bin/zsh
set -e

# ==============================================================================
# EasyWhisper - macOS Local Speech-to-Text & Subtitle Automation
# https://github.com/semhfe/easywhisper-mac
# ==============================================================================

export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

# 1. Konfigürasyonu yükle (varsa)
CONFIG_FILE="$HOME/.config/easywhisper/config.env"
if [[ -f "$CONFIG_FILE" ]]; then
    source "$CONFIG_FILE"
fi

# 2. Değişkenleri ve varsayılanları belirle
WHISPER_BIN="${WHISPER_BIN:-}"
MODEL_PATH="${MODEL_PATH:-}"
VAD_MODEL_PATH="${VAD_MODEL_PATH:-}"
LANGUAGE="${LANGUAGE:-tr}"
PROMPT="${PROMPT:-Keep original language. No translation.}"
ENTROPY_THRESHOLD="${ENTROPY_THRESHOLD:-2.8}"
MAX_CONTEXT="${MAX_CONTEXT:-64}"

# Otomatik whisper-cli tespiti
if [[ -z "$WHISPER_BIN" || ! -x "$WHISPER_BIN" ]]; then
    for candidate in \
        "$(which whisper-cli 2>/dev/null)" \
        "/opt/homebrew/bin/whisper-cli" \
        "/usr/local/bin/whisper-cli" \
        "$HOME/whisper.cpp/build/bin/whisper-cli" \
        "$HOME/whisper.cpp/main"; do
        if [[ -n "$candidate" && -x "$candidate" ]]; then
            WHISPER_BIN="$candidate"
            break
        fi
    done
fi

# Otomatik Model tespiti
if [[ -z "$MODEL_PATH" || ! -f "$MODEL_PATH" ]]; then
    for candidate in \
        "$HOME/.easywhisper/models/ggml-large-v3-turbo.bin" \
        "$HOME/whisper.cpp/models/ggml-large-v3-turbo.bin" \
        "$HOME/.cache/whisper/ggml-large-v3-turbo.bin"; do
        if [[ -f "$candidate" ]]; then
            MODEL_PATH="$candidate"
            break
        fi
    done
fi

# Otomatik VAD Model tespiti
if [[ -z "$VAD_MODEL_PATH" || ! -f "$VAD_MODEL_PATH" ]]; then
    for candidate in \
        "$HOME/.easywhisper/models/ggml-silero-v5.1.2.bin" \
        "$HOME/whisper.cpp/models/ggml-silero-v5.1.2.bin"; do
        if [[ -f "$candidate" ]]; then
            VAD_MODEL_PATH="$candidate"
            break
        fi
    done
fi

# Bağımlılık kontrolleri
if [[ -z "$WHISPER_BIN" || ! -x "$WHISPER_BIN" ]]; then
    echo "\033[1;31m[HATA] whisper-cli bulunamadı!\033[0m" >&2
    echo "Lütfen 'brew install whisper-cpp' kurun veya install.sh çalıştırın." >&2
    osascript -e 'display notification "whisper-cli bulunamadı! Lütfen install.sh çalıştırın." with title "EasyWhisper Hata" sound name "Basso"' 2>/dev/null || true
    exit 1
fi

if [[ -z "$MODEL_PATH" || ! -f "$MODEL_PATH" ]]; then
    echo "\033[1;31m[HATA] Whisper model dosyası (.bin) bulunamadı!\033[0m" >&2
    echo "Lütfen modeli indirin veya config dosyasını (~/.config/easywhisper/config.env) düzenleyin." >&2
    osascript -e 'display notification "Model dosyası bulunamadı!" with title "EasyWhisper Hata" sound name "Basso"' 2>/dev/null || true
    exit 1
fi

# Bildirim fonksiyonları
notify_start() {
    local title="EasyWhisper"
    local msg="Altyazı üretimi başlatıldı: $1"
    osascript -e "display notification \"$msg\" with title \"$title\"" 2>/dev/null || true
}

notify_done() {
    local title="EasyWhisper"
    local msg="Altyazı başarıyla oluşturuldu: $1"
    osascript -e "display notification \"$msg\" with title \"$title\" sound name \"Glass\"" 2>/dev/null || true
}

notify_error() {
    local title="EasyWhisper - Hata"
    local msg="İşlem başarısız oldu: $1"
    osascript -e "display notification \"$msg\" with title \"$title\" sound name \"Basso\"" 2>/dev/null || true
}

# Tek bir videoyu işleyen ana fonksiyon
process_video() {
    local video_path="$1"

    if [[ ! -f "$video_path" ]]; then
        echo "\033[1;31m[HATA] Dosya bulunamadı: $video_path\033[0m" >&2
        return 1
    fi

    local filename=$(basename "$video_path")
    local dirpath=$(dirname "$video_path")
    local base_no_ext="${video_path:r}"
    local srt_path="${base_no_ext}.srt"
    local lock_path="${base_no_ext}.lock"

    # Zaten .srt üretilmişse atla
    if [[ -f "$srt_path" ]]; then
        echo "\033[1;33m[BİLGİ] Altyazı zaten mevcut, atlanıyor: $srt_path\033[0m"
        return 0
    fi

    # Kilit kontrolü (paralel işlem engelleme)
    if [[ -f "$lock_path" ]]; then
        local lock_pid=$(cat "$lock_path" 2>/dev/null || true)
        if [[ -n "$lock_pid" ]] && kill -0 "$lock_pid" 2>/dev/null; then
            echo "\033[1;33m[BİLGİ] Dosya şu an başka bir süreç tarafından işleniyor (PID $lock_pid): $filename\033[0m"
            return 0
        else
            echo "\033[1;33m[UYARI] Eski/kalıntı lock dosyası temizleniyor: $lock_path\033[0m"
            rm -f "$lock_path"
        fi
    fi

    # Kilit oluştur
    echo "$$" > "$lock_path"

    local tmp_wav="/tmp/whisper_$(date +%s)_$$.wav"
    cleanup() {
        rm -f "$tmp_wav" "$lock_path" 2>/dev/null || true
    }
    trap cleanup EXIT INT TERM

    echo ""
    echo "\033[1;36m============================================================\033[0m"
    echo "\033[1;32m  🎙️  EASYWHISPER - CANLI ALTYAZI AKIŞI\033[0m"
    echo "\033[1;36m============================================================\033[0m"
    echo "📁 Video: \033[1m$filename\033[0m"
    echo "⚙️  Model: $(basename "$MODEL_PATH") | Dil: $LANGUAGE"
    [[ -n "$VAD_MODEL_PATH" ]] && echo "🛡️  VAD:   $(basename "$VAD_MODEL_PATH") (Silero)"
    echo "------------------------------------------------------------"
    notify_start "$filename"

    # 1. ffmpeg ile 16kHz mono pcm_s16le WAV oluştur
    echo "\033[1;33m>> [1/2] 🔊 Ses ayrıştırılıyor (ffmpeg 16kHz Mono WAV)...\033[0m"
    if ! ffmpeg -y -loglevel error -i "$video_path" -vn -ar 16000 -ac 1 -c:a pcm_s16le "$tmp_wav"; then
        echo "\033[1;31m[HATA] ffmpeg ses dönüştürme başarısız oldu: $video_path\033[0m" >&2
        notify_error "$filename (ffmpeg hatası)"
        cleanup
        trap - EXIT INT TERM
        return 1
    fi

    # 2. whisper.cpp ile SRT üret
    echo "\033[1;33m>> [2/2] 🧠 Whisper transkripsiyonu çalışıyor (Canlı Akış)...\033[0m"
    echo ""
    local vad_args=()
    if [[ -n "$VAD_MODEL_PATH" && -f "$VAD_MODEL_PATH" ]]; then
        vad_args=(--vad -vm "$VAD_MODEL_PATH")
    fi

    local prompt_args=()
    if [[ -n "$PROMPT" ]]; then
        prompt_args=(--prompt "$PROMPT")
    fi

    if ! "$WHISPER_BIN" \
        -m "$MODEL_PATH" \
        "${vad_args[@]}" \
        -l "$LANGUAGE" \
        -osrt \
        -pp \
        -pc \
        "${prompt_args[@]}" \
        -et "$ENTROPY_THRESHOLD" -mc "$MAX_CONTEXT" \
        -f "$tmp_wav" \
        -of "$base_no_ext"; then
        echo "\033[1;31m[HATA] whisper.cpp işlemi başarısız oldu: $video_path\033[0m" >&2
        notify_error "$filename (whisper hatası)"
        cleanup
        trap - EXIT INT TERM
        return 1
    fi

    cleanup
    trap - EXIT INT TERM

    if [[ -f "$srt_path" ]]; then
        echo ""
        echo "\033[1;32m============================================================\033[0m"
        echo "\033[1;32m  ✅ ALTYAZI BAŞARIYLA OLUŞTURULDU!\033[0m"
        echo "\033[1;32m  📄 Dosya: $srt_path\033[0m"
        echo "\033[1;32m============================================================\033[0m"
        notify_done "$(basename "$srt_path")"
        open -R "$srt_path" 2>/dev/null || true
    else
        echo "\033[1;31m[HATA] Beklenen SRT dosyası bulunamadı: $srt_path\033[0m" >&2
        notify_error "$filename (SRT oluşturulamadı)"
        return 1
    fi
}

# Klasör tarama modu (--scan-dir)
scan_directory() {
    local target_dir="$1"
    if [[ ! -d "$target_dir" ]]; then
        echo "\033[1;31m[HATA] Taranacak dizin bulunamadı: $target_dir\033[0m" >&2
        return 1
    fi

    local scan_lock="$target_dir/.scan.lock"
    if [[ -f "$scan_lock" ]]; then
        local scan_pid=$(cat "$scan_lock" 2>/dev/null || true)
        if [[ -n "$scan_pid" ]] && kill -0 "$scan_pid" 2>/dev/null; then
            echo "[BİLGİ] Dizin şu an zaten taranıyor (PID $scan_pid): $target_dir"
            return 0
        else
            rm -f "$scan_lock"
        fi
    fi

    echo "$$" > "$scan_lock"
    scan_cleanup() {
        rm -f "$scan_lock" 2>/dev/null || true
    }
    trap scan_cleanup EXIT INT TERM

    setopt null_glob nocaseglob
    local video_files=("$target_dir"/*.(mp4|mkv|mov|avi|webm|m4v))
    unsetopt nocaseglob null_glob

    for video in "${video_files[@]}"; do
        [[ -f "$video" ]] || continue

        local fname=$(basename "$video")

        if [[ "$fname" == *.crdownload || "$fname" == *.part || "$fname" == *.download || "$fname" == .* ]]; then
            continue
        fi

        local sz1=$(stat -f %z "$video" 2>/dev/null || echo 0)
        if [[ "$sz1" -eq 0 ]]; then
            continue
        fi
        sleep 1
        local sz2=$(stat -f %z "$video" 2>/dev/null || echo 0)
        if [[ "$sz1" -ne "$sz2" ]]; then
            echo "[BİLGİ] Dosya henüz indiriliyor/yazılıyor: $fname"
            continue
        fi

        if lsof "$video" 2>/dev/null | grep -qE " (W|u) "; then
            echo "[BİLGİ] Dosyaya aktif yazma işlemi sürüyor: $fname"
            continue
        fi

        process_video "$video" || true
    done

    scan_cleanup
    trap - EXIT INT TERM
}

# ==============================================================================
# Giriş Noktası
# ==============================================================================

if [[ $# -eq 0 ]]; then
    echo "EasyWhisper CLI"
    echo "Kullanım:"
    echo "  $0 <video_dosyasi_1> [video_dosyasi_2 ...]"
    echo "  $0 --scan-dir <klasor_yolu>"
    exit 1
fi

if [[ "$1" == "--scan-dir" ]]; then
    if [[ -z "$2" ]]; then
        echo "[HATA] --scan-dir için klasör yolu belirtilmedi." >&2
        exit 1
    fi
    scan_directory "$2"
else
    for arg in "$@"; do
        process_video "$arg"
    done

    if [[ -t 0 || -t 1 ]]; then
        echo ""
        echo "\033[1;30m(Pencere 10 sn sonra otomatik kapanacaktır, hemen kapatmak için Enter'a basabilirsiniz...)\033[0m"
        read -t 10 || true
    fi
fi
