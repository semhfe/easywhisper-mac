<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.easywhisper.watch</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>{{HOME}}/.local/bin/easywhisper --scan-dir {{HOME}}/Desktop/EasyWhisper_Watch</string>
    </array>
    <key>WatchPaths</key>
    <array>
        <string>{{HOME}}/Desktop/EasyWhisper_Watch</string>
    </array>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/tmp/easywhisper_agent.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/easywhisper_agent.err</string>
</dict>
</plist>
